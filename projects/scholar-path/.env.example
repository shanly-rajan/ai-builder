# Non-secret application defaults
SCHOLARPATH_APP_NAME=ScholarPath
SCHOLARPATH_ENVIRONMENT=development
SCHOLARPATH_LOG_LEVEL=INFO
SCHOLARPATH_DISCOVERY_FAILURE_MODE=off

# Shared by OpenAI adapters and required only when an OpenAI-backed agent is instantiated.
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-5.4-mini
OPENAI_PLANNING_TIMEOUT_SECONDS=60

# Required only when the OpenAI Evidence Verification Agent processes a retrieved page.
OPENAI_EVIDENCE_MODEL=gpt-5.4-mini
OPENAI_EVIDENCE_TIMEOUT_SECONDS=60

# Required only when the OpenAI Research Fit Evaluation Agent scores verified evidence.
OPENAI_RESEARCH_FIT_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_FIT_TIMEOUT_SECONDS=60

# Required only when the Nebius Independent Review Agent reviews Research Fit.
NEBIUS_API_KEY=
NEBIUS_REVIEW_MODEL=Qwen/Qwen3-235B-A22B
NEBIUS_ENDPOINT=https://api.tokenfactory.nebius.com/v1/
NEBIUS_REVIEW_TIMEOUT_SECONDS=60

# Required only when the You.com Supervisor search adapter is instantiated.
YDC_API_KEY=
YOU_SEARCH_ENDPOINT=https://ydc-index.io/v1/search
YOU_SEARCH_TIMEOUT_SECONDS=20
YOU_SEARCH_RESULT_COUNT=10

# Required only when resilient discovery routes to the Tavily fallback.
TAVILY_API_KEY=
TAVILY_SEARCH_TIMEOUT_SECONDS=20
TAVILY_SEARCH_RESULT_COUNT=10

# Used when evidence retrieval reaches Tavily Extract. The application deadline must
# remain greater than the provider timeout.
TAVILY_EXTRACT_PROVIDER_TIMEOUT_SECONDS=20
TAVILY_EXTRACT_REQUEST_TIMEOUT_SECONDS=25
TAVILY_EXTRACT_DEPTH=advanced
TAVILY_EXTRACT_MAX_CONTENT_CHARACTERS=50000

# Optional LangSmith tracing. Keep disabled for local/offline test runs.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scholarpath

# Generic future provider adapters may use the existing nested-key boundary:
# SCHOLARPATH_PROVIDER_API_KEYS__PROVIDER_NAME=
