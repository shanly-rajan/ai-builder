# Non-secret application defaults
SCHOLARPATH_APP_NAME=ScholarPath
SCHOLARPATH_ENVIRONMENT=development
SCHOLARPATH_LOG_LEVEL=INFO
# Provider-backed `live` is the default. `deterministic_demo` uses fixed synthetic adapters,
# forces tracing off, uses in-memory checkpoints, and is rejected in production. Fully stop and
# restart Streamlit after changing this value; a browser rerun does not rebuild the cached runtime.
SCHOLARPATH_RUNTIME_PROFILE=live
# Strict requires identity, current affiliation, and research evidence plus a five-Supervisor
# verified cohort. The explicit MVP standard requires directly grounded identity only, visibly
# defers the other evidence gates, and continues with a minimum cohort of two. Its implicit
# discovery and verified-cohort floors are both two. The proposed shortlist remains capped at
# five under both standards.
SCHOLARPATH_VERIFICATION_EVIDENCE_STANDARD=strict
SCHOLARPATH_DISCOVERY_FAILURE_MODE=off
SCHOLARPATH_CHECKPOINT_DATABASE_PATH=.scholarpath/checkpoints.sqlite3

# Shared by OpenAI adapters and required only when an OpenAI-backed agent is instantiated.
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-5.4-mini
OPENAI_PLANNING_TIMEOUT_SECONDS=60

# Required only when the OpenAI Evidence Verification Agent processes a retrieved page.
OPENAI_EVIDENCE_MODEL=gpt-5.4-mini
OPENAI_EVIDENCE_TIMEOUT_SECONDS=60

# Required only when the OpenAI Research Fit Evaluation Agent scores verified evidence.
OPENAI_RESEARCH_FIT_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_FIT_TIMEOUT_SECONDS=60

# Required only when the Nebius Independent Review Agent reviews Research Fit.
NEBIUS_API_KEY=
NEBIUS_REVIEW_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_ENDPOINT=https://api.tokenfactory.nebius.com/v1/
NEBIUS_REVIEW_TIMEOUT_SECONDS=60

# Required only when the You.com Supervisor search adapter is instantiated.
YDC_API_KEY=
YOU_SEARCH_ENDPOINT=https://ydc-index.io/v1/search
YOU_SEARCH_TIMEOUT_SECONDS=20
YOU_SEARCH_RESULT_COUNT=10

# Required only when resilient discovery routes to the Tavily fallback.
TAVILY_API_KEY=
TAVILY_SEARCH_TIMEOUT_SECONDS=20
TAVILY_SEARCH_RESULT_COUNT=10

# Used when evidence retrieval reaches Tavily Extract. The application deadline must
# remain greater than the provider timeout.
TAVILY_EXTRACT_PROVIDER_TIMEOUT_SECONDS=20
TAVILY_EXTRACT_REQUEST_TIMEOUT_SECONDS=25
TAVILY_EXTRACT_DEPTH=advanced
TAVILY_EXTRACT_MAX_CONTENT_CHARACTERS=50000

# Required only when persistent Candidate preference memory is activated.
# Telemetry is disabled by default to avoid sending Candidate-memory SDK metadata.
MEM0_API_KEY=
MEM0_TIMEOUT_SECONDS=20
MEM0_MEMORY_LIMIT=100
MEM0_TELEMETRY=false

# Optional LangSmith tracing. Keep disabled for local/offline test runs.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scholarpath
LANGSMITH_REQUEST_TIMEOUT_SECONDS=10
LANGSMITH_MAXIMUM_RETRY_COUNT=2
# Required only when the API key is scoped to more than one workspace.
LANGSMITH_WORKSPACE_ID=

# Live provider checks remain inert unless explicitly selected. The M13 canary
# additionally requires its narrower second opt-in and permits at most nine logical calls.
SCHOLARPATH_RUN_LIVE_TESTS=false
SCHOLARPATH_RUN_LIVE_CANARY=false
SCHOLARPATH_LIVE_CANARY_SUPERVISOR_NAME=
SCHOLARPATH_LIVE_CANARY_INSTITUTION=
SCHOLARPATH_LIVE_CANARY_PROFILE_URL=

# LangSmith evaluation uploads remain disabled unless this explicit opt-in is true.
SCHOLARPATH_RUN_LANGSMITH_EVALS=false
# Live end-to-end evaluation additionally requires this second explicit opt-in.
SCHOLARPATH_RUN_LIVE_E2E_EVALS=false
SCHOLARPATH_EVALUATION_DATASET_NAME=scholarpath-m12-regression-v1
SCHOLARPATH_EVALUATION_EXPERIMENT_PREFIX=scholarpath-m12
SCHOLARPATH_EVALUATION_JUDGE_MODEL=gpt-5.4-mini
SCHOLARPATH_EVALUATION_JUDGE_TIMEOUT_SECONDS=60

# Generic future provider adapters may use the existing nested-key boundary:
# SCHOLARPATH_PROVIDER_API_KEYS__PROVIDER_NAME=
